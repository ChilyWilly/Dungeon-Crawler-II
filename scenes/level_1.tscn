[sub_resource type="GDScript" id="GDScript_15mv3"]
resource_name = "door_open"
script/source = "extends StaticBody2D


@onready var door_button: Area2D = $Button
@onready var door_sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var door_collision: CollisionShape2D = $CollisionShape2D


func _ready():
	door_button.button_pressed.connect(_on_door_open)


func _on_door_open():
	door_sprite.play(\"open\")
	door_collision.set_deferred(\"disabled\", true)
"

[sub_resource type="GDScript" id="GDScript_w5bra"]
resource_name = "Give Player: Key"
script/source = "extends Node


@onready var chest: Area2D = $\"..\"


func _ready():
	chest.chest_opened.connect(_on_chest_opened)
	
	
func _on_chest_opened():
	GameManager.money += 100
	print(GameManager.money)
"

[sub_resource type="GDScript" id="GDScript_djxyh"]
resource_name = "Give Player: Money"
script/source = "extends Node


@onready var chest_2: Area2D = $\"..\"


func _ready():
	chest_2.chest_opened.connect(_on_chest_opened)
	
	
func _on_chest_opened():
	GameManager.money += 200
	print(GameManager.money)
"

